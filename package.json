{
	"name": "fire_handling_sys",
	"version": "0.1.0",
	"description": "A comprehensive fire department management system with role-based access control, inventory management, staff management, and more.",
	"main": "index.js",
	"scripts": {
		"backend:dev": "cd backend && npm run backend:dev",
		"backend:prod": "cd backend && npm run backend:prod",
		"frontend:dev": "cd frontend && npm run dev",
		"dev": "concurrently \"npm run backend:dev\" \"npm run frontend:dev\"",
		"backend:deps": "cd backend && npm i --legacy-peer-deps",
		"frontend:deps": "cd frontend && npm i --legacy-peer-deps",
		"deps": "npm run frontend:deps && npm run backend:deps",
		"seed": "cd backend && npm run seed:all"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ViduraTheekshana/FireLink-SL.git"
	},
	"bugs": {
		"url": "https://github.com/ViduraTheekshana/FireLink-SL/issues"
	},
	"homepage": "https://github.com/ViduraTheekshana/FireLink-SL#readme",
	"devDependencies": {
		"concurrently": "^9.2.1"
	}
}
